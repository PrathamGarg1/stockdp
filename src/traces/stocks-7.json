{"cpp":"class Solution {\npublic:\n    long long maxProfit(vector<int>& prices, vector<int>& startegy, int k) {\n        // atmost one modification    \n        int n=prices.size();\n        vector<long long>simpleStrategy(n,prices[0]*startegy[0]);\n        vector<long long>pre(n,prices[0]);\n        for(int i=1;i<n;i++){\n            simpleStrategy[i]  = simpleStrategy[i-1] + prices[i]*startegy[i];\n            pre[i]  = pre[i-1] + prices[i];\n        }\n        long long normalStrategy = simpleStrategy[n-1];\n        long long ans=(pre[k-1]-pre[k/2-1])-(simpleStrategy[k-1]);\n        for(int i=1;k-1+i<n;i++){\n            ans=max(ans,(pre[k-1+i]-pre[k/2-1+i])-(simpleStrategy[k-1+i]-simpleStrategy[i-1]));\n        }\n        return max(normalStrategy,normalStrategy+ans);\n    }\n};","result":"10","frames":[{"line":5,"depth":0,"fn":"maxProfit","vars":{"prices":[4,2,8],"startegy":[-1,0,1],"k":2},"args":["prices","startegy","k"],"mem":{}},{"line":6,"depth":0,"fn":"maxProfit","vars":{"prices":[4,2,8],"startegy":[-1,0,1],"k":2,"n":3},"args":["prices","startegy","k"],"mem":{}},{"line":7,"depth":0,"fn":"maxProfit","vars":{"prices":[4,2,8],"startegy":[-1,0,1],"k":2,"n":3,"simpleStrategy":[-4,-4,-4]},"args":["prices","startegy","k"],"mem":{}},{"line":8,"depth":0,"fn":"maxProfit","vars":{"prices":[4,2,8],"startegy":[-1,0,1],"k":2,"n":3,"simpleStrategy":[-4,-4,-4],"pre":[4,4,4]},"args":["prices","startegy","k"],"mem":{}},{"line":9,"depth":0,"fn":"maxProfit","vars":{"prices":[4,2,8],"startegy":[-1,0,1],"k":2,"n":3,"simpleStrategy":[-4,-4,-4],"pre":[4,4,4],"i":1},"args":["prices","startegy","k"],"mem":{}},{"line":10,"depth":0,"fn":"maxProfit","vars":{"prices":[4,2,8],"startegy":[-1,0,1],"k":2,"n":3,"simpleStrategy":[-4,-4,-4],"pre":[4,4,4],"i":1},"args":["prices","startegy","k"],"mem":{}},{"line":11,"depth":0,"fn":"maxProfit","vars":{"prices":[4,2,8],"startegy":[-1,0,1],"k":2,"n":3,"simpleStrategy":[-4,-4,-4],"pre":[4,6,4],"i":1},"args":["prices","startegy","k"],"mem":{}},{"lin