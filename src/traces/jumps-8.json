{"cpp":"class Solution {\npublic:\n    vector<int>ngeIdx,nseIdx;\n\n    int n;\n    long long dp[100005];\n    vector<int> costs;\n    long long rec(int i){\n        if(i==n) return 1e11;\n        if(i==n-1) return costs[i];\n        if(dp[i]!=-1) return dp[i];\n        return dp[i]=costs[i]+min(rec(ngeIdx[i]),rec(nseIdx[i]));\n    }\n\n    long long minCost(vector<int>&arr, vector<int>& cost) {\n        costs=cost;\n        n=arr.size();\n        ngeIdx.assign(n,n);\n        nseIdx.assign(n,n);\n        stack<int>st;\n        memset(dp,-1,sizeof(dp));\n        for(int i=n-1;i>=0;i--){\n            while(!st.empty() && arr[st.top()] < arr[i]) st.pop();\n            if(!st.empty()) ngeIdx[i]=st.top();\n            st.push(i);\n        }\n        while(!st.empty()) st.pop();\n        for(int i=n-1;i>=0;i--){\n            while(!st.empty() && arr[st.top()] >= arr[i]) st.pop();\n            if(!st.empty()) nseIdx[i]=st.top();\n            st.push(i);\n        }\n        return rec(0)-cost[0];\n    }\n};","result":"8","frames":[{"line":16,"depth":0,"fn":"minCost","vars":{"arr":[3,2,4,4,1],"cost":[3,7,6,4,2]},"args":["arr","cost"],"mem":{"ngeIdx":[],"nseIdx":[],"n":0,"dp":[0,0,0,0,0,0],"costs":[]}},{"line":17,"depth":0,"fn":"minCost","vars":{"arr":[3,2,4,4,1],"cost":[3,7,6,4,2]},"args":["arr","cost"],"mem":{"ngeIdx":[],"nseIdx":[],"n":0,"dp":[0,0,0,0,0,0],"costs":[3,7,6,4,2]}},{"line":18,"depth":0,"fn":"minCost","vars":{"arr":[3,2,4,4,1],"cost":[3,7,6,4,2]},"args":["arr","cost"],"mem":{"ngeIdx":[],"nseIdx":[],"n":5,"dp":[0,0,0,0,0,0],"costs":[3,7,6,4,2]}},{"line":19,"depth":0,"fn":"minCost","vars":{"arr":[3,2,4,4,1],"cost":[3,7,6,4,2]},"args":["arr","cost"],"mem":{"ngeIdx":[5,5,5,5,5],"nseIdx":[],"n":5,"dp":[0,0,0,0,0,0],"costs":[3,7,6,4,2]}},{"line":20,"depth":0,"fn":"minCost","vars":{"arr":[3,2,4,4,1],"cost":[3,7,6,4,2]},"args":["arr","cost"],"mem":{"ngeIdx":[5,5,5,5,5],"nseIdx":[5,5,5,5,5],"n":5,"dp":[0,0,0,0,0,0],"costs":[3,7,6,4,2]}},{"line":21,"depth":0,"fn":"minCos