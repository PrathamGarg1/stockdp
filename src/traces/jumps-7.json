{"cpp":"class Solution {\npublic:\n    bool canReach(string s, int minj, int maxj) {\n        int n=s.size();\n        queue<int>q;\n        vector<bool>dp(n,0);\n        dp[0]=1;\n        if(minj==1) q.push(1);\n        for(int i=1;i<n;i++){\n            dp[i] =( s[i]=='0') &&  !q.empty();\n            if(i+1-minj>=0 && dp[i+1-minj]) q.push(1);\n            if(i-maxj>=0 && dp[i-maxj]) q.pop();\n        }\n        return dp[n-1];\n    }\n};","result":"true","frames":[{"line":4,"depth":0,"fn":"canReach","vars":{"s":"011010","minj":2,"maxj":3},"args":["s","minj","maxj"],"mem":{}},{"line":5,"depth":0,"fn":"canReach","vars":{"s":"011010","minj":2,"maxj":3,"n":6},"args":["s","minj","maxj"],"mem":{}},{"line":6,"depth":0,"fn":"canReach","vars":{"s":"011010","minj":2,"maxj":3,"n":6,"q":[]},"args":["s","minj","maxj"],"mem":{}},{"line":7,"depth":0,"fn":"canReach","vars":{"s":"011010","minj":2,"maxj":3,"n":6,"q":[],"dp":[false,false,false,false,false,false]},"args":["s","minj","maxj"],"mem":{}},{"line":8,"depth":0,"fn":"canReach","vars":{"s":"011010","minj":2,"maxj":3,"n":6,"q":[],"dp":[true,false,false,false,false,false]},"args":["s","minj","maxj"],"mem":{}},{"line":9,"depth":0,"fn":"canReach","vars":{"s":"011010","minj":2,"maxj":3,"n":6,"q":[],"dp":[true,false,false,false,false,false]},"args":["s","minj","maxj"],"mem":{}},{"line":10,"depth":0,"fn":"canReach","vars":{"s":"011010","minj":2,"maxj":3,"n":6,"q":[],"dp":[true,false,false,false,false,false],"i":1},"args":["s","minj","maxj"],"mem":{}},{"line":11,"depth":0,"fn":"canReach","vars":{"s":"011010","minj":2,"maxj":3,"n":6,"q":[],"dp":[true,false,false,false,false,false],"i":1},"args":["s","minj","maxj"],"mem":{}},{"line":12,"depth":0,"fn":"canReach","vars":{"s":"011010","minj":2,"maxj":3,"n":6,"q":[1],"dp":[true,false,false,false,false,false],"i":1},"args":["s","minj","maxj"],"mem":{}},{"line":13,"depth":0,"fn":"canReach","vars":{"s":"011010","minj":2,"maxj":3,"n":6,"q":[1],"dp":[true,false,false,false,false,false],"i":1},