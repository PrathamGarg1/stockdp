    "cpp": "class Solution {\npublic:\n    bool canJump(vector<int>& arr) {\n        int n=arr.size();\n        int i=0;\n        int bandwidth = 0;\n        while(i<n-1){\n            bandwidth=max(bandwidth,arr[i]);\n            if(!bandwidth) return 0;\n            bandwidth--;\n            i++;\n        }\n        return true;\n    }\n};",
