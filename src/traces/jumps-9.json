{"cpp":"class Solution {\npublic:\n    vector<int> maxValue(vector<int>& arr) {\n        int n=arr.size();\n        vector<int>pre(n,arr[0]);\n        vector<int>ans(n,-1);\n        for(int i=1;i<n;i++){\n            pre[i]=max(pre[i-1],arr[i]);\n        }\n        int i=n-1;\n        while(i>=0){\n            int j=i;\n            int val = pre[j];\n            ans[j]=val;\n            int minv = arr[i];\n            while(j-1>=0 && pre[j-1] > minv){\n                ans[j-1]=val;\n                minv=min(minv,arr[j-1]);\n                j--;\n            }\n            i=j-1;\n        }\n        return ans;\n\n    \n    \n    \n    }\n};","result":"[2,2,3]","frames":[{"line":4,"depth":0,"fn":"maxValue","vars":{"arr":[2,1,3]},"args":["arr"],"mem":{}},{"line":5,"depth":0,"fn":"maxValue","vars":{"arr":[2,1,3],"n":3},"args":["arr"],"mem":{}},{"line":6,"depth":0,"fn":"maxValue","vars":{"arr":[2,1,3],"n":3,"pre":[2,2,2]},"args":["arr"],"mem":{}},{"line":7,"depth":0,"fn":"maxValue","vars":{"arr":[2,1,3],"n":3,"pre":[2,2,2],"ans":[-1,-1,-1]},"args":["arr"],"mem":{}},{"line":8,"depth":0,"fn":"maxValue","vars":{"arr":[2,1,3],"n":3,"pre":[2,2,2],"ans":[-1,-1,-1],"i":1},"args":["arr"],"mem":{}},{"line":9,"depth":0,"fn":"maxValue","vars":{"arr":[2,1,3],"n":3,"pre":[2,2,2],"ans":[-1,-1,-1],"i":1},"args":["arr"],"mem":{}},{"line":7,"depth":0,"fn":"maxValue","vars":{"arr":[2,1,3],"n":3,"pre":[2,2,2],"ans":[-1,-1,-1],"i":1},"args":["arr"],"mem":{}},{"line":8,"depth":0,"fn":"maxValue","vars":{"arr":[2,1,3],"n":3,"pre":[2,2,2],"ans":[-1,-1,-1],"i":2},"args":["arr"],"mem":{}},{"line":9,"depth":0,"fn":"maxValue","vars":{"arr":[2,1,3],"n":3,"pre":[2,2,3],"ans":[-1,-1,-1],"i":2},"args":["arr"],"mem":{}},{"line":7,"depth":0,"fn":"maxValue","vars":{"arr":[2,1,3],"n":3,"pre":[2,2,3],"ans":[-1,-1,-1],"i":2},"args":["arr"],"mem":{}},{"line":10,"depth":0,"fn":"maxValue","vars":{"arr":[2,1,3],"n":3,"pre":[2,2,3],"ans":[-1,-1,-1]},"args":["arr"],"mem":{}},{"line":11,"depth":0,"fn":"maxValue","