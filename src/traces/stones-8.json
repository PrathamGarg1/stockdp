{"cpp":"class Solution {\npublic:\n\n    int stoneGameVIII(vector<int>& arr) {\n\n        int n=arr.size();\n        vector<int>pre;\n        pre.assign(n,arr[0]);\n        for(int i=1;i<n;i++){\n            pre[i]=pre[i-1]+arr[i];\n        }\n\n\n        vector<vector<int>>dp(n+1,vector<int>(2,0));\n        dp[n][1]=0;\n        dp[n][0]=0;\n\n        vector<int>maxdp(n+1,0);\n        maxdp[n]=pre[n-1];\n\n        vector<int>mindp(n+1,0);\n        mindp[n]=-pre[n-1];\n\n        for(int i=n-1;i>=1;i--){\n            for(int turn=0;turn<2;turn++){\n                dp[i][turn]= turn ? (maxdp[i+1]) :( mindp[i+1]);\n            }\n            maxdp[i] = max(maxdp[i+1],pre[i-1]+dp[i][0]);\n            mindp[i] = min(mindp[i+1],-pre[i-1]+dp[i][1]);\n        }\n\n\n        return dp[1][1];\n    }\n};","result":"5","frames":[{"line":6,"depth":0,"fn":"stoneGameVIII","vars":{"arr":[-1,2,-3,4,-5]},"args":["arr"],"mem":{}},{"line":7,"depth":0,"fn":"stoneGameVIII","vars":{"arr":[-1,2,-3,4,-5],"n":5},"args":["arr"],"mem":{}},{"line":8,"depth":0,"fn":"stoneGameVIII","vars":{"arr":[-1,2,-3,4,-5],"n":5,"pre":[]},"args":["arr"],"mem":{}},{"line":9,"depth":0,"fn":"stoneGameVIII","vars":{"arr":[-1,2,-3,4,-5],"n":5,"pre":[-1,-1,-1,-1,-1]},"args":["arr"],"mem":{}},{"line":10,"depth":0,"fn":"stoneGameVIII","vars":{"arr":[-1,2,-3,4,-5],"n":5,"pre":[-1,-1,-1,-1,-1],"i":1},"args":["arr"],"mem":{}},{"line":11,"depth":0,"fn":"stoneGameVIII","vars":{"arr":[-1,2,-3,4,-5],"n":5,"pre":[-1,1,-1,-1,-1],"i":1},"args":["arr"],"mem":{}},{"line":9,"depth":0,"fn":"stoneGameVIII","vars":{"arr":[-1,2,-3,4,-5],"n":5,"pre":[-1,1,-1,-1,-1],"i":1},"args":["arr"],"mem":{}},{"line":10,"depth":0,"fn":"stoneGameVIII","vars":{"arr":[-1,2,-3,4,-5],"n":5,"pre":[-1,1,-1,-1,-1],"i":2},"args":["arr"],"mem":{}},{"line":11,"depth":0,"fn":"stoneGameVIII","vars":{"arr":[-1,2,-3,4,-5],"n":5,"pre":[-1,1,-2,-1,-1],"i":2},"args":["arr"],"mem":{}},{"line":9,"depth":0,"fn":"stoneGameVIII","vars":{"arr":[-1,2,-3,4,-5],"n":5,"pre":[