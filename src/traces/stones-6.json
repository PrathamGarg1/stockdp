{"cpp":"class Solution {\npublic:\n    int stoneGameVI(vector<int>& a, vector<int>& b) {\n        // a-b karo fir max nikalo \n        int n=a.size();\n        vector<pair<int,int>>arr;\n        for(int i=0;i<n;i++) arr.push_back({a[i],b[i]});\n        sort(arr.begin(),arr.end(),[&](pair<int,int>&a,pair<int,int>&b){\n            return a.first+a.second>b.first+b.second;\n        });\n        int ca=0;\n        int cb=0;\n        for(int i=0;i<n;i++){\n            if(i%2==0) ca += arr[i].first;\n            else cb += arr[i].second;\n        }\n        if(ca>cb) return 1;\n        if(ca<cb) return -1;\n        return 0;\n    }\n};","result":"1","frames":[{"line":5,"depth":0,"fn":"stoneGameVI","vars":{"a":[1,3],"b":[2,1]},"args":["a","b"],"mem":{}},{"line":6,"depth":0,"fn":"stoneGameVI","vars":{"a":[1,3],"b":[2,1],"n":2},"args":["a","b"],"mem":{}},{"line":7,"depth":0,"fn":"stoneGameVI","vars":{"a":[1,3],"b":[2,1],"n":2,"arr":[]},"args":["a","b"],"mem":{}},{"line":8,"depth":0,"fn":"stoneGameVI","vars":{"a":[1,3],"b":[2,1],"n":2,"arr":[{"first":1,"second":2},{"first":3,"second":1}]},"args":["a","b"],"mem":{}},{"line":11,"depth":0,"fn":"stoneGameVI","vars":{"a":[1,3],"b":[2,1],"n":2,"arr":[{"first":3,"second":1},{"first":1,"second":2}]},"args":["a","b"],"mem":{}},{"line":12,"depth":0,"fn":"stoneGameVI","vars":{"a":[1,3],"b":[2,1],"n":2,"arr":[{"first":3,"second":1},{"first":1,"second":2}],"ca":0},"args":["a","b"],"mem":{}},{"line":13,"depth":0,"fn":"stoneGameVI","vars":{"a":[1,3],"b":[2,1],"n":2,"arr":[{"first":3,"second":1},{"first":1,"second":2}],"ca":0,"cb":0},"args":["a","b"],"mem":{}},{"line":14,"depth":0,"fn":"stoneGameVI","vars":{"a":[1,3],"b":[2,1],"n":2,"arr":[{"first":3,"second":1},{"first":1,"second":2}],"ca":0,"cb":0,"i":0},"args":["a","b"],"mem":{}},{"line":16,"depth":0,"fn":"stoneGameVI","vars":{"a":[1,3],"b":[2,1],"n":2,"arr":[{"first":3,"second":1},{"first":1,"second":2}],"ca":3,"cb":0,"i":0},"args":["a","b"],"mem":{}},{"line":13,"depth":0,"fn":"stoneGame